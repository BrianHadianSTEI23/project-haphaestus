# Vivado CAD temporary and journal files
.Xil/
*.jou
*.log
vivado*.backup.*

# Simulation binary outputs and waveforms
*.vcd
build/sim/

# Vivado Project generated files
build/vivado_proj/

# Python compiled cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# LaTeX compilation auxiliary files
*.aux
*.nav
*.snm
*.toc
*.out
*.fls
*.fdb_latexmk
*.synctex.gz

.vscode/
research_direction.md

# Versioned regenerated binary artifacts (metadata/checksums tracked in git)
world_models_fpga/research/datasets/splits_v2/*.npz
world_models_fpga/research/datasets/splits_v3/*.npz
world_models_fpga/research/datasets/splits_v4/*.npz
world_models_fpga/checkpoints_v2/*.pt
world_models_fpga/checkpoints_v3/*.pt
world_models_fpga/checkpoints_v4/*.pt
